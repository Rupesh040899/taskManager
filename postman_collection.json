{
  "info": {
    "name": "Task Manager API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Task",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"title\": \"Test task\", \"description\": \"desc\", \"status\": \"pending\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/tasks",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tasks"
          ]
        }
      }
    },
    {
      "name": "Get All Tasks",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/tasks",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tasks"
          ]
        }
      }
    },
    {
      "name": "Get Task",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/tasks/:id",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tasks",
            ":id"
          ]
        }
      }
    },
    {
      "name": "Update Task",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"title\": \"Updated\" }"
        },
        "url": {
          "raw": "{{baseUrl}}/api/tasks/:id",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tasks",
            ":id"
          ]
        }
      }
    },
    {
      "name": "Delete Task",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/api/tasks/:id",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tasks",
            ":id"
          ]
        }
      }
    }
  ]
}